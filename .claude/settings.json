{
  "enabledMcpjsonServers": ["coreflux-docs", "coreflux-broker"],
  "permissions": {
    "allow": [
      "mcp__coreflux-docs",
      "mcp__coreflux-broker__get_broker_info",
      "mcp__coreflux-broker__get_available_commands",
      "mcp__coreflux-broker__diagnose",
      "mcp__coreflux-broker__explore_topics",
      "mcp__coreflux-broker__validate_lot",
      "mcp__coreflux-broker__validate_lotnb",
      "mcp__coreflux-broker__list_entities",
      "mcp__coreflux-broker__list_routes",
      "mcp__coreflux-broker__list_agents",
      "mcp__coreflux-broker__list_things",
      "mcp__coreflux-broker__list_panels",
      "mcp__coreflux-broker__list_projects",
      "mcp__coreflux-broker__list_action_tools",
      "mcp__coreflux-broker__list_route_templates",
      "mcp__coreflux-broker__get_route_template",
      "mcp__coreflux-broker__get_panel_code",
      "mcp__coreflux-broker__get_pending_status",
