# Copiar para .env (que não vai para o git) e preencher.
# Código de licença do evento Coreflux (CFLX-...). Vazio = Community Edition.
COREFLUX_ACTIVATION_CODE=

# Interface onde o MQTT (1883) fica exposto. 127.0.0.1 = só esta máquina.
# 0.0.0.0 = toda a rede (só com a password de root alterada!).
MQTT_BIND=127.0.0.1
