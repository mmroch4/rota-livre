# Copy to .env (which is not committed) and fill in.
# Coreflux event licence code (CFLX-...). Empty = Community Edition.
COREFLUX_ACTIVATION_CODE=

# Interface where MQTT (1883) is exposed. 127.0.0.1 = this machine only.
# 0.0.0.0 = the whole network (only after changing the root password!).
MQTT_BIND=127.0.0.1
